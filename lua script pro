        for p in pairs(touched) do pcall(function() if p.Parent then p.CanCollide=true end end) end
        touched={}
        local char=LP.Character
        if char then for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then pcall(function() p.CanCollide=true end) end end end
    end
    reg(RunService.Heartbeat:Connect(function()
        if not ST_ref[key] then if next(touched) then restore() end;return end
        local n=tick();if n-ls<2.5 then return end;ls=n
        restore()
        for _,p in ipairs(workspace:GetDescendants()) do
            if p:IsA("BasePart") and p.Anchored and p.Name~="Baseplate" and p.Size.Magnitude<500 and p.CanCollide then
                p.CanCollide=false;touched[p]=true
            end
        end
        local char=LP.Character
        if char then for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.CanCollide then p.CanCollide=false end end end
    end))
end

-- ── God mode helper (instant hook) ────────────────────────────────────
local function makeGodSystem(ST_ref,key)
    local godHumanoid=nil
    local godConns={}
    local function hookGod(hm)
        if not hm then return end
        for _,c in ipairs(godConns) do pcall(function() c:Disconnect() end) end
        godConns={};godHumanoid=hm
        pcall(function() hm:SetStateEnabled(Enum.HumanoidStateType.Dead,false) end)
        hm.MaxHealth=1e9;hm.Health=1e9
        table.insert(godConns,hm.HealthChanged:Connect(function(v)
            if v<hm.MaxHealth and v>0 then pcall(function() hm.Health=hm.MaxHealth end) end
        end))
        table.insert(godConns,hm.Died:Connect(function()
            pcall(function() hm.Health=hm.MaxHealth end)
        end))
    end
    local function setGod(on)
        if not on then
            for _,c in ipairs(godConns) do pcall(function() c:Disconnect() end) end
            godConns={};godHumanoid=nil
            local char=LP.Character;local hm=char and char:FindFirstChildOfClass("Humanoid")
            if hm then pcall(function() hm:SetStateEnabled(Enum.HumanoidStateType.Dead,true) end) end
            return
        end
        local char=LP.Character;local hm=char and char:FindFirstChildOfClass("Humanoid")
        if hm then hookGod(hm) end
    end
    reg(LP.CharacterAdded:Connect(function(char)
        local hm=char:WaitForChild("Humanoid",3)
        if ST_ref[key] and hm then hookGod(hm) end
    end))
    reg(RunService.Heartbeat:Connect(function()
        if not ST_ref[key] then return end
        local char=LP.Character;local hm=char and char:FindFirstChildOfClass("Humanoid")
        if hm and hm~=godHumanoid then hookGod(hm) end
        if hm and hm.Health>0 and hm.Health<hm.MaxHealth then pcall(function() hm.Health=hm.MaxHealth end) end
    end))
    return setGod
end

-- ── Fly helper (WASD + pitch) ─────────────────────────────────────────
local function makeFlySystem(ST_ref,key,speedKey)
    local flyBV,flyBG
    local function rebuildFly()
        local char=LP.Character;local hrp=char and char:FindFirstChild("HumanoidRootPart")
        if flyBV then pcall(function() flyBV:Destroy() end);flyBV=nil end
        if flyBG then pcall(function() flyBG:Destroy() end);flyBG=nil end
        if not hrp then return end
        flyBV=Instance.new("BodyVelocity");flyBV.MaxForce=Vector3.new(1e9,1e9,1e9);flyBV.Velocity=Vector3.zero;flyBV.Parent=hrp
        flyBG=Instance.new("BodyGyro");flyBG.MaxTorque=Vector3.new(1e9,1e9,1e9);flyBG.P=1e4;flyBG.CFrame=hrp.CFrame;flyBG.Parent=hrp
    end
    local function setFly(on)
        if on then rebuildFly()
        else
            if flyBV then pcall(function() flyBV:Destroy() end);flyBV=nil end
            if flyBG then pcall(function() flyBG:Destroy() end);flyBG=nil end
        end
    end
    reg(LP.CharacterAdded:Connect(function() if ST_ref[key] then task.wait(0.4);rebuildFly() end end))
    reg(RunService.RenderStepped:Connect(function()
        if not ST_ref[key] or not flyBV or not flyBG then return end
        local char=LP.Character;local hum=char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local camCF=Camera.CFrame
        local fwd=camCF.LookVector
        local right=camCF.RightVector
        local flatFwd=Vector3.new(fwd.X,0,fwd.Z)
        if flatFwd.Magnitude<0.01 then flatFwd=Vector3.new(0,0,-1) end
        flatFwd=flatFwd.Unit
        local moveDir=flatFwd*-hum.MoveDirection.Z + right*hum.MoveDirection.X
        local vert=fwd.Y
        local spd=ST_ref[speedKey] or 80
        local finalVel
        if moveDir.Magnitude>0.05 or math.abs(vert)>0.1 then
            finalVel=(moveDir.Unit*spd)+Vector3.new(0,vert*spd,0)
        else
            finalVel=Vector3.zero
        end
        flyBV.Velocity=finalVel
        flyBG.CFrame=CFrame.new(Vector3.zero,flatFwd)+camCF.Position
    end))
    return setFly
end

